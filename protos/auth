syntax = "proto3";

package pairing;

message OuterMessage {
  enum MessageType {
    MESSAGE_TYPE_UNKNOWN = 0;
    MESSAGE_TYPE_PAIRING_REQUEST = 10;
    MESSAGE_TYPE_PAIRING_REQUEST_ACK = 11;
  
    MESSAGE_TYPE_OPTIONS = 20;
    MESSAGE_TYPE_CONFIGURATION = 30;
    MESSAGE_TYPE_CONFIGURATION_ACK = 31;
   
    MESSAGE_TYPE_SECRET = 40;
    MESSAGE_TYPE_SECRET_ACK = 41;
  }
  
  enum Status {
    STATUS_UNKNOWN = 0;
    STATUS_OK = 200;
    STATUS_ERROR = 400;
    STATUS_BAD_CONFIGURATION = 401;
    STATUS_BAD_SECRET = 402;
  }
  uint32 protocol_version = 1;
  uint32 status = 2;
  optional MessageType type = 3;
  optional bytes payload = 4;
}

// Initialization messages
message PairingRequest {
  string service_name = 1;  // String name of the service to pair with.
  optional string client_name = 2;   // Descriptive name of the client.
}
message PairingRequestAck {
  optional string server_name = 1;  // Descriptive name of the server.
}

// Configuration messages
message Options {
  message Encoding {
    enum EncodingType {
      ENCODING_TYPE_UNKNOWN = 0;
      ENCODING_TYPE_ALPHANUMERIC = 1;
      ENCODING_TYPE_NUMERIC = 2;
      ENCODING_TYPE_HEXADECIMAL = 3;
      ENCODING_TYPE_QRCODE = 4;
    }
    EncodingType type = 1;
    uint32 symbol_length = 2;
  }
  enum RoleType {
    ROLE_TYPE_UNKNOWN = 0;
    ROLE_TYPE_INPUT = 1;
    ROLE_TYPE_OUTPUT = 2;
  }
  repeated Encoding input_encodings = 1;   // List of encodings this endpoint accepts when serving as an input device.
  repeated Encoding output_encodings = 2;  // List of encodings this endpoint can generate as an output device.
  optional RoleType preferred_role = 3;    // Preferred role, if any.
}

message Configuration {
  // The encoding to be used in this session.
  Options.Encoding encoding = 1;
  // The role of the client (i.e., the one initiating pairing).  
  Options.RoleType client_role = 2;
}
message ConfigurationAck {
}

// Pairing messages
message Secret {
  bytes secret = 1;
}
message SecretAck {
  bytes secret = 1;
}